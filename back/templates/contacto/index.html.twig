{% extends 'base.html.twig' %} {% block title %} {{ 'Contact us' | trans }} {% endblock %} {% block
body %}
<div id="main-container" class="container my-5">
  {% for message in app.flashes('success') %}
        <div class="alert alert-success text-center w-50 mx-auto my-2">{{ message }}</div>
      {% endfor %}

      {% for message in app.flashes('warning') %}
        <div class="alert alert-warning text-center w-50 mx-auto my-2">{{ message }}</div>
      {% endfor %}

      {% for message in app.flashes('danger') %}
        <div class="alert alert-danger text-center w-50 mx-auto my-2">{{ message }}</div>
      {% endfor %}
  <h2 class="titulo__contacto text-center w-100 mb-5">
    {{ 'Contact us' | trans }}
  </h2>
  <div class="container">
    {{ form_start(form, { action: path("contacto", {'_locale': app.request.locale}) }) }}
    <div class="row mx-3">
      <div class="col-md-6">
        {{ form_row(form.nombre) }}
      </div>
      <div class="col-md-6">
        {{ form_row(form.email) }}
      </div>
      <div class="col-md-12">
        {{ form_row(form.mensaje) }}
      </div>

      <button type="submit" class="btn-primary col-md-6 mx-auto mt-3">
        {{ 'Send' | trans }}
      </button>

      {{ form_end(form) }}
    </div>
    {# {% if app.user %} {% include 'app/_side_menu.html.twig' %} {% endif %} #}
  </div>
</div>
{% endblock %}
