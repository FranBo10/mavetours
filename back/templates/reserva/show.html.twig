{% extends 'base.html.twig' %} {% block title %}Reservar{% endblock %} 
{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.0/themes/base/jquery-ui.css">
{% endblock %}
{%
  block body %}
  <div id="main-container" class="container-fluid my-5">
    {% for type in ['danger', 'warning', 'success'] %}
      {% for message in app.flashes(type) %}
      <div class="alert alert-{{ type }} text-center w-50 mx-auto my-2">
        <p>{{ message }}</p>
      </div>
      {% endfor %}
    {% endfor %}
      <h2 class="titulo__reservas text-center w-100 mb-3">Realiza tu reserva</h2>
    {% for tour in reserva.tours %}
    <div class="reserva-container container-fluid">
      <img
        src="{{ asset('uploads/images/' ~ tour.imagen) }}"
        alt="{{ tour.titulo }}"
        width="350px"
        height="280px"
      />   
      <div class="detalles-reserva">
        <ul>
          <h2>{{ tour.titulo | title }}</h2> 
          <li>
            {% if tour.precio == 0 %}
              <p><span>Precio: Free Tour</span></p>
              {% else %}
              <p>{{ tour.precio/100|number_format(2, '.') }} €</p>
              {% endif %}
            </td>
          </li>
  
          {{
            form_start(form, { attr: { novalidate: "novalidate", method: "POST" } })
          }}
          <li>
              {{ form_label(form.cantidad_adultos, 'Selecciona el número de adultos')}} 
              {{ form_widget(form.cantidad_adultos, {'attr': {'class': 'task_field'}}) }}
            
          </li>
          <li>
            {{ form_label(form.cantidad_kids, 'Selecciona el número de niños')}} 
              {{ form_widget(form.cantidad_kids, {'attr': {'class': 'task_field'}}) }}
            
          </li>
          <li>
            <label for="detalles_reserva_form_fecha_evento">Selecciona la fecha</label>
            {# {{ form_label(form.fecha_evento, 'Selecciona una fecha') }} #}
            <input type="text" id="fecha_evento" name="fecha_evento" class="datepicker form-control" autocomplete="off" 
            value="{{ detallesReserva.fechaEvento|default('now')|date('Y-m-d') }}" required>
          </li> 
          <li id="hora-selector-wrapper">
             <label for="hora_evento_select">Selecciona la hora</label>
             <select id="hora_evento_select" name="hora_evento" class="form-control">
                 <option value="">Selecciona fecha primero...</option>
             </select>
          </li>
          <li>
            <div class="buttons">
              <a href="{{ path('home') }}" class="btn-tertiary my-3">Ver más tours</a>
              {% if app.user %}
              <div class="left-buttons">
                <button type="submit" class="btn-primary">
                  Validar reserva
                </button>
              </div>
              {% else %}
              <div class="left-buttons">
                <a href="{{ path('app_login') }}" class="btn-primary-card">
                  Reservar
                </a>
              </div>
              {% endif %}
            </div>
          </li>
          {# Ocultar el campo fecha_evento del formulario Symfony (usamos nuestro datepicker personalizado) #}
          <div style="display: none;">
            {{ form_row(form.fecha_evento) }}
          </div>
          {{
            form_end(form)
          }}
        </ul>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endblock %}
  {% block javascripts %}
  <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
  <script src="https://code.jquery.com/ui/1.14.0/jquery-ui.js"></script>
  <style>
      .ui-datepicker td.past-date a { color: #ccc !important; pointer-events: none; }
      .ui-datepicker td.blocked-date a { background: #ffcccc !important; color: #a00 !important; pointer-events: none; }
      .ui-datepicker td.full-date a { background: #ffcccc !important; color: #a00 !important; cursor: not-allowed; }
      .ui-datepicker td.available-date a { background: #ccffcc !important; color: #006600 !important; }
      /* Diagonal split for partial availability */
      .ui-datepicker td.partial-date a { 
          background: linear-gradient(135deg, #ffcccc 50%, #ccffcc 50%) !important; 
          color: #000 !important; 
      }
      #hora-selector-wrapper { display: none; margin-top: 10px; }
  </style>
  <script>
    // Datos desde el servidor
    var scheduleData = {{ scheduleData|raw }};
    
    $(document).ready(function() {
        $.datepicker.regional['es'] = {
            closeText: 'Cerrar',
            prevText: '< Ant',
            nextText: 'Sig >',
            currentText: 'Hoy',
            monthNames: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
            monthNamesShort: ['Ene','Feb','Mar','Abr', 'May','Jun','Jul','Ago','Sep', 'Oct','Nov','Dic'],
            dayNames: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'],
            dayNamesShort: ['Dom','Lun','Mar','Mié','Juv','Vie','Sáb'],
            dayNamesMin: ['Do','Lu','Ma','Mi','Ju','Vi','Sá'],
            weekHeader: 'Sm',
            dateFormat: 'dd/mm/yy',
            firstDay: 1,
            isRTL: false,
            showMonthAfterYear: false,
            yearSuffix: ''
        };
        $.datepicker.setDefaults($.datepicker.regional['es']);

        var $horaSelect = $('#hora_evento_select');
        var $horaWrapper = $('#hora-selector-wrapper');

        $('#fecha_evento').datepicker({
            dateFormat: 'yy-mm-dd',
            minDate: 0,
            beforeShowDay: function(date) {
                var fechaStr = $.datepicker.formatDate('yy-mm-dd', date);
                
                // 1. Bloqueado explícitamente?
                if (scheduleData.blocked.includes(fechaStr)) {
                    return [false, 'blocked-date', 'No disponible'];
                }

                // 2. Calcular slots disponibles
                var slots = getSlotsForDate(fechaStr);
                
                if (slots.length === 0) {
                    return [false, 'blocked-date', 'Sin horarios'];
                }

                // 3. Verificar ocupación
                var fullCount = 0;
                var openCount = 0;

                slots.forEach(function(slot) {
                    if (slot.full) fullCount++;
                    else openCount++;
                });

                if (openCount === 0) {
                   return [false, 'full-date', 'Completo']; // Todo lleno
                } else if (fullCount > 0) {
                   return [true, 'partial-date', 'Disponibilidad parcial'];
                } else {
                   return [true, 'available-date', 'Disponible'];
                }
            },
            onSelect: function(dateText) {
                updateHoraSelector(dateText);
            }
        });

        function getSlotsForDate(dateStr) {
            // Empieza con horario base
            var baseSlots = scheduleData.base; 
            var result = [];

            // Si hay info específica del evento
            var eventInfo = scheduleData.events[dateStr] || {};

            baseSlots.forEach(function(time) {
                var info = eventInfo[time];
                var isFull = false;
                var label = time;

                if (info) {
                    if (info.full || info.closed) {
                        isFull = true;
                        label += ' (Completo)';
                    } else {
                        label += ' (' + info.remaining + ' plazas)';
                    }
                }

                result.push({
                    time: time,
                    full: isFull,
                    label: label
                });
            });

            return result;
        }

        function updateHoraSelector(dateStr) {
            var slots = getSlotsForDate(dateStr);
            $horaSelect.empty();
            
            var availableCount = 0;
            
            // Opción por defecto
            $horaSelect.append('<option value="">Selecciona hora...</option>');

            slots.forEach(function(slot) {
                if (!slot.full) {
                    $horaSelect.append('<option value="' + slot.time + '">' + slot.label + '</option>');
                    availableCount++;
                } else {
                    $horaSelect.append('<option value="' + slot.time + '" disabled>' + slot.label + '</option>');
                }
            });

            if (availableCount > 0) {
                $horaWrapper.show();
                $horaSelect.prop('required', true);
            } else {
                $horaWrapper.hide();
                $horaSelect.prop('required', false);
                alert('No hay horarios disponibles para esta fecha.');
            }
        }
    });
  </script>
  {% endblock %}


