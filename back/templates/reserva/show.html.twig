{% extends 'base.html.twig' %} {% block title %}Reservar{% endblock %} 
{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.0/themes/base/jquery-ui.css">
{% endblock %}
{%
  block body %}
  <div id="main-container" class="container-fluid my-5">
    {% for message in app.flashes('danger') %}
    <div class="alert alert-danger text-center w-50 mx-auto my-2">
      <p>{{ message }}</p>
    </div>
    {% endfor %}
      <h2 class="titulo__reservas text-center w-100 mb-3">Realiza tu reserva</h2>
    {% for tour in reserva.tours %}
    <div class="reserva-container container-fluid">
      <img
        src="{{ asset('uploads/images/' ~ tour.imagen) }}"
        alt="{{ tour.titulo }}"
        width="350px"
        height="280px"
      />   
      <div class="detalles-reserva">
        <ul>
          <h3>{{ tour.titulo | title }} : {{ tour.horaInicio|date("H:i") }} h -
                {{ tour.horaFin|date("H:i") }} h</h3> 
          <li>
            {% if tour.precio == 0 %}
              <p><span>Precio: Free Tour</span></p>
              {% else %}
              <p>{{ tour.precio/100|number_format(2, '.') }} €</p>
              {% endif %}
            </td>
          </li>
  
          {{
            form_start(form, { attr: { novalidate: "novalidate", method: "POST" } })
          }}
          <li>
              {{ form_label(form.cantidad_adultos, 'Selecciona el número de adultos')}} 
              {{ form_widget(form.cantidad_adultos, {'attr': {'class': 'task_field'}}) }}
            
          </li>
          <li>
            {{ form_label(form.cantidad_kids, 'Selecciona el número de niños')}} 
              {{ form_widget(form.cantidad_kids, {'attr': {'class': 'task_field'}}) }}
            
          </li>
          <li>
            <label for="detalles_reserva_form_fecha_evento">Selecciona la fecha</label>
            {# {{ form_label(form.fecha_evento, 'Selecciona una fecha') }} #}
            <input type="text" id="fecha_evento" name="fecha_evento" class="datepicker form-control" autocomplete="off" 
            value="{{ detallesReserva.fechaEvento|default('now')|date('Y-m-d') }}" required>
          </li> 
          <li>
            <div class="buttons">
              <a href="{{ path('home') }}" class="btn-tertiary my-3">Ver más tours</a>
              {% if app.user %}
              <div class="left-buttons">
                <button type="submit" class="btn-primary">
                  Validar reserva
                </button>
              </div>
              {% else %}
              <div class="left-buttons">
                <a href="{{ path('app_login') }}" class="btn-primary-card">
                  Reservar
                </a>
              </div>
              {% endif %}
            </div>
          </li>
          {# Ocultar el campo fecha_evento del formulario Symfony (usamos nuestro datepicker personalizado) #}
          <div style="display: none;">
            {{ form_row(form.fecha_evento) }}
          </div>
          {{
            form_end(form)
          }}
        </ul>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endblock %}
  {% block javascripts %}
  <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
  <script src="https://code.jquery.com/ui/1.14.0/jquery-ui.js"></script>
  <script>
    // Fechas no disponibles y activas desde el servidor
    var fechasNoDisponibles = {{ fechasNoDisponibles|json_encode()|raw }};
    var fechasActivas = {{ fechasActivas|json_encode()|raw }};
    var plazasDisponibles = {{ plazasDisponibles|json_encode()|raw }};

    console.log(fechasActivas);
    console.log(fechasNoDisponibles);
    
    // Inicializar datepicker
    $(document).ready(function() {
      $.datepicker.regional['es'] = {
        closeText: 'Cerrar',
        prevText: '< Ant',
        nextText: 'Sig >',
        currentText: 'Hoy',
        monthNames: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
        monthNamesShort: ['Ene','Feb','Mar','Abr', 'May','Jun','Jul','Ago','Sep', 'Oct','Nov','Dic'],
        dayNames: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'],
        dayNamesShort: ['Dom','Lun','Mar','Mié','Juv','Vie','Sáb'],
        dayNamesMin: ['Do','Lu','Ma','Mi','Ju','Vi','Sá'],
        weekHeader: 'Sm',
        dateFormat: 'dd/mm/yy',
        firstDay: 1,
        isRTL: false,
        showMonthAfterYear: false,
        yearSuffix: ''
        };
        $.datepicker.setDefaults($.datepicker.regional['es']);
      // Inicializar el datepicker
      $('#fecha_evento').datepicker({
          dateFormat: 'yy-mm-dd',
          //beforeShow: function(input, inst) {
              // Obtener el ancho del input y ajustar el datepicker
              //var inputWidth = $(input).outerWidth();
             // console.log(inputWidth);
              //inst.dpDiv.css('width', inputWidth + 'px');
          //},
          beforeShowDay: function(date) {
              var fecha = $.datepicker.formatDate('yy-mm-dd', date);
              
              var hoy = new Date();
                hoy.setHours(0, 0, 0, 0); // Asegúrate de comparar solo la fecha

                // Si la fecha es anterior al día actual, marcar como no disponible
                if (date < hoy) {
                    return [false, 'past-date', 'Fecha pasada - No disponible']; // Clase 'past-date' para fechas pasadas
                }
  
              // Verificar si la fecha está en las no disponibles
              if (fechasNoDisponibles.includes(fecha)) {
                  return [false, 'disabled-date', 'No disponible']; // Deshabilitado
              }
  
              // Verificar si la fecha está en las activas
            if (fecha || fechasActivas.includes(fecha)) {
              var plazasLibres = plazasDisponibles[fecha] || "Disponibles"; // Obtener plazas disponibles o 0
              return [true, 'active-date', 'Plazas libres: ' + plazasLibres]; // Mostrar plazas libres
          }
  
              return [true, '', 'Fecha No Disponible']; // Disponible sin estilo especial
          }
      });
  });
  
</script>
{% endblock %}


