{% extends 'base.html.twig' %}

{% block title %}{{ ciudad.nombre }} - Tours{% endblock %}

{% block nav %}
    {% include '_partials/_menu_nav.html.twig' %}
{% endblock %}

{% block body %}

<section class="hero">
    <div class="hero-background">
        <div class="hero-content">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success text-center w-50 mx-auto my-2">
                    <p>{{ message }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

    <div class="servicios">
        <div class="titulo__servicios">
            <h2>{{ "Tours in" | trans }} {{ ciudad.nombre }}</h2>
        </div>

        <div class="cards">
            {% for item in toursCiudad %}
                {% if item.estado %}
                    <article class="card">
                        <img src="{{ asset('uploads/images/' ~ item.imagen) }}" alt="{{ item.titulo | trans }}">

                        <div class="content card-text">
                            <h4>{{ item.titulo | trans | raw }}</h4>

                            <div class="hidden-elements">
                                {% if item.precio == 0 %}
                                    <h5>{{ "Price:" | trans }} <span>Free Tour</span></h5>
                                {% else %}
                                    <h5>
                                        {{ "Price:" | trans }}
                                        {{ (item.precio / 100)|number_format(2, '.', ',') }} €
                                    </h5>
                                {% endif %}

                                <div class="card-btn">
                                    <a href="{{ path('tour', { id: item.id }) }}" class="btn-tertiary-card">
                                        {{ "INFO" | trans }}
                                    </a>

                                    {% if app.user %}
                                        <a href="{{ path('show', { id: item.id }) }}" class="btn-primary-card">
                                            {{ "FREETOUR" | trans }}
                                        </a>
                                        <a href="{{ path('parada', { id: item.id }) }}" class="btn-warning-card">
                                            {{ "AUDIOGUIDE" | trans }}
                                        </a>
                                    {% else %}
                                        <a href="{{ path('app_login') }}" class="btn-primary-card">
                                            {{ "FREETOUR" | trans }}
                                        </a>
                                        <a href="{{ path('app_login') }}" class="btn-warning-card">
                                            {{ "AUDIOGUIDE" | trans }}
                                        </a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </article>
                {% endif %}
            {% else %}
                <div class="titulo__servicios">
                    <p>{{ "No tours available yet in" | trans }} {{ ciudad.nombre }}</p>
                </div>
            {% endfor %}
        </div>
    </div>


{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('menu') }}
    {{ encore_entry_script_tags('cookies') }}
{% endblock %}
