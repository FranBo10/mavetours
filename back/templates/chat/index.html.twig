{% extends 'base.html.twig' %}

{% block title %}Chat Community{% endblock %}

{% block body %}
<div id="main-container-chat" class="container my-5">
    <div class="row">
        <!-- Área del Chat -->
        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-comments me-2"></i>Sala de Chat</h5>
                </div>
                <div class="card-body d-flex flex-column">
                    <div id="chat-messages" class="grow overflow-auto mb-3 p-3 border rounded bg-light">
                        <!-- Los mensajes aparecerán aquí -->
                        <div class="text-center text-muted small mt-2">Comienza la conversación...</div>
                    </div>
                    
                    <div class="input-group position-relative">
                        <button class="btn btn-primary" type="button" id="emoji-trigger">
                            <i class="far fa-smile text-white"></i>
                        </button>
                        <input type="text" id="chat-input" class="form-control" placeholder="Escribe tu mensaje aquí..." autocomplete="off">
                        <button class="btn btn-primary" type="button" id="btn-send">
                            <i class="fas fa-paper-plane"></i> Enviar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información del Usuario -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-user-circle me-2"></i>Tu Perfil</h5>
                </div>
                <div class="card-body text-center">
                    {% if app.user %}
                        <div class="mb-4">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/images/avatars/' ~ app.user.avatar ~ '.jpg') }}" 
                                     class="rounded-circle img-thumbnail shadow-sm" 
                                     style="width: 150px; height: 150px; object-fit: cover;" 
                                     alt="Avatar de {{ app.user.nombre }}">
                            {% else %}
                                <img src="https://via.placeholder.com/150" 
                                     class="rounded-circle img-thumbnail shadow-sm" 
                                     alt="Avatar por defecto">
                            {% endif %}
                        </div>
                        <h3 class="card-title mb-1">{{ app.user.nombre }}</h3>
                        <h4 class="card-subtitle text-muted mb-3">{{ app.user.apellidos }}</h4>
                        
                        <div class="d-grid gap-2">
                            <span class="badge bg-info text-dark p-2">Usuario Conectado</span>
                        </div>
                    {% else %}
                        <div class="alert alert-warning">
                            No estás conectado.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('chat') }}
{% endblock %}
